# Supabase — Project settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client bundle. Project settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Firebase client config — Project settings > General > Your apps in the Firebase console
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only) — Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences from the downloaded JSON's private_key field.
FIREBASE_PRIVATE_KEY=

# Optional but recommended: any random string. Set the same value in Vercel's
# project env vars — Vercel automatically sends it as a Bearer token when it
# invokes the daily cron job (see vercel.json) that pings Supabase to keep
# the free-tier project from auto-pausing after 7 days of inactivity.
CRON_SECRET=
