{
  "name": "batteryorvansh-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Vansh Dixit's portfolio: a deck of battery cells.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/lint-copy.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "todos": "node scripts/list-todos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6"
  }
}
